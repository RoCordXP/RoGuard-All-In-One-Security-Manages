<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.roguard</groupId>
    <artifactId>RoGuard</artifactId>
    <version>1.4</version>
    <packaging>jar</packaging>

    <name>RoGuards</name>
    <description>Clean RoGuard 2.0 build project</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.11-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.dv8tion</groupId>
            <artifactId>JDA</artifactId>
            <version>5.6.1</version>
            <exclusions>
                <exclusion>
                    <groupId>club.minnced</groupId>
                    <artifactId>opus-java</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.crypto.tink</groupId>
                    <artifactId>tink</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.9</version>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
        <finalName>RoGuards-${project.version}</finalName>

        <resources>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                    <include>config.yml</include>
                    <include>setup.yml</include>
                    <include>commands.yml</include>
                    <include>userbypass.yml</include>
                    <include>language/**</include>
                    <include>META-INF/services/**</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <includes>
                        <include>com/roguard/RoGuard.java</include>
                        <include>com/roguard/util/TextUtil.java</include>
                        <include>com/roguard/config/ConfigManager.java</include>
                        <include>com/roguard/config/LanguageManager.java</include>
                        <include>com/roguard/manager/PlayerDataManager.java</include>
                        <include>com/roguard/manager/AuthManager.java</include>
                        <include>com/roguard/manager/LoginShieldManager.java</include>
                        <include>com/roguard/manager/TwoFactorManager.java</include>
                        <include>com/roguard/manager/VerifyManager.java</include>
                        <include>com/roguard/manager/PunishmentManager.java</include>
                        <include>com/roguard/antivpn/VpnChecker.java</include>
                        <include>com/roguard/logging/SensitiveLogFilter.java</include>
                        <include>com/roguard/dialog/Dialogs.java</include>
                        <include>com/roguard/dialog/PlayerDialogs.java</include>
                        <include>com/roguard/inventory/InventoryManager.java</include>
                        <include>com/roguard/inventory/SnapshotStore.java</include>
                        <include>com/roguard/discord/EmojiResolver.java</include>
                        <include>com/roguard/discord/SecurityBot.java</include>
                        <include>com/roguard/discord/ChatBot.java</include>
                        <include>com/roguard/discord/TwoFaBot.java</include>
                        <include>com/roguard/discord/ConsoleAppender.java</include>
                        <include>com/roguard/listener/AuthListener.java</include>
                        <include>com/roguard/listener/AuthDialogListener.java</include>
                        <include>com/roguard/listener/CommandListener.java</include>
                        <include>com/roguard/listener/PlayerListener.java</include>
                        <include>com/roguard/listener/ShopkeeperListener.java</include>
                        <include>com/roguard/listener/GamemodeListener.java</include>
                        <include>com/roguard/listener/AntiVpnListener.java</include>
                        <include>com/roguard/listener/PlayerManagerListener.java</include>
                        <include>com/roguard/command/RoGuardCommand.java</include>
                        <include>com/roguard/command/AuthCommand.java</include>
                        <include>com/roguard/command/TwoFaCommand.java</include>
                    </includes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <relocations>
                                <relocation>
                                    <pattern>net.dv8tion.jda</pattern>
                                    <shadedPattern>com.roguard.libs.jda</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>